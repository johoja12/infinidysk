    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <Compile Include="$(LegacySourceRoot)/backend/Services/NativeCache/NativeCacheStore.cs" Link="Source/NativeCacheStore.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Services/NativeCache/NativeCacheBrowserStore.cs" Link="Source/NativeCacheBrowserStore.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Services/NativeCache/NativeCacheFolder.cs" Link="Source/NativeCacheFolder.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Services/NativeCache/NativeFileSystem.cs" Link="Source/NativeFileSystem.cs" />
