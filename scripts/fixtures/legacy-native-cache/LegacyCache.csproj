    <Compile Include="$(LegacySourceRoot)/backend/Services/NativeCache/MultipartContentIdentity.cs" Link="Source/MultipartContentIdentity.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Database/Models/DavNzbFile.cs" Link="Source/DavNzbFile.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Database/Models/DavMultipartFile.cs" Link="Source/DavMultipartFile.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Models/LongRange.cs" Link="Source/LongRange.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Models/AesParams.cs" Link="Source/AesParams.cs" />
    <Compile Include="$(LegacySourceRoot)/backend/Models/Par2FileProof.cs" Link="Source/Par2FileProof.cs" />
  </ItemGroup>
</Project>
