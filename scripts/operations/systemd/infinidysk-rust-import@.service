[Unit]
Description=Resume one sealed InfiniDysk Rust import pass (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=infinidysk-migration
Group=infinidysk-migration
EnvironmentFile=/etc/infinidysk/rust-migration/%i.env
LoadCredential=api-key:/etc/infinidysk/rust-migration/%i.api-key
StateDirectory=infinidysk-rust-import-%i
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 /opt/infinidysk-tools/scripts/operations/rust-import-runner.py --run --package ${PACKAGE_PATH} --manifest-digest ${MANIFEST_DIGEST} --url ${RUST_URL} --server-commit ${RUST_COMMIT} --api-key-file %d/api-key --journal %S/infinidysk-rust-import-%i/acceptance.jsonl --category migration-canary --import-slots 2
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
